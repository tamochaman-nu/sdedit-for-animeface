# .env にコピーして各自の環境に合わせる (.env は git 管理外)。
# ~ は展開されないので、ホストのパスは絶対パスかリポジトリからの相対パスで書く。
# ディレクトリは先に作っておく (無いと docker compose run が止まる)。

# --- シーンの入出力 ---
# 別のシーンを変換するときは、この 2 つだけを変える。
# シーンの入力フレーム (/data/input に読み取り専用でマウント)。input/<シーン名>/ に置く (input/ は git 管理外)。
# 例: 3DGS の COLMAP の画像 (<3DGS の出力>/<シーン名>/colmap/images/) をコピーしたもの
HOST_INPUT_DIR=./input/sample04-12119910
# 全段の出力 (/data/output)。landmarks.json, aligned/, parse/, convert/, pasted/, verify/ ができる
HOST_OUTPUT_DIR=./output/sample04-12119910

# --- 通し (pipeline) の設定。空なら採用構成のまま ---
# 動かす段 (空なら "landmarks align parse convert paste")
STAGES=
# ①②③⑥ に足す引数 (空白で区切る)。例: PASTE_OPTS=--feather 0.1。④⑤ の設定は docker compose run --rm pipeline [opts] で渡す
LANDMARKS_OPTS=
ALIGN_OPTS=
PARSE_OPTS=
PASTE_OPTS=

# --- モデル・設定・統計 (コンテナ内のパス。/app はリポジトリ) ---
# アニメ顔 DDPM のチェックポイント (ddpm/ は git 管理外。約 531MB)
MODEL_PATH=ddpm/anime-face256-mp128-ema_0.9995_250000.pt
# 推論用の cfg (学習時の cfg の CHANNEL_MULT だけを埋めたもの。根拠はファイル冒頭のコメント)
MODEL_CFG=ddpm/cfg/face256-mp128-ema_0.9995_250000.infer.cfg
# ④ 色の写像の統計 (scripts/fit_face_color_stats.py の出力)
COLOR_STATS=lists/face_color_stats.json

# --- 重みのキャッシュ (/home/app/.cache) ---
# torch hub (2DFAN4, s3fd) と BiSeNet (resnet18.pt)。無ければ初回に torch hub と GitHub の公開 URL から取得する
HOST_CACHE_DIR=./.cache

# --- 色の写像の統計の作り直し (fit-color-stats) ---
# 実写の顔 (背景除去済みの FFHQ。/data/real_face に読み取り専用でマウント)
HOST_REAL_FACE_DIR=/path/to/ffhq512x512-bg-removed
# アニメ顔のデータ (/data/anime_face に読み取り専用でマウント)
HOST_ANIME_FACE_DIR=/path/to/danbooru_work/export/512-filtered-v2

# --- 回帰確認 (verify, export-orig) ---
# 元リポジトリ (ilvr-for-anime-faceparts、/orig に読み取り専用でマウント)
HOST_ORIG_REPO=/path/to/ilvr-for-anime-faceparts
# 元の実行のイメージ (export-orig が使う。ビルドはしない)
ORIG_IMAGE=ilvr-anime-faceparts:latest
# 出力の目の検出 (detect-eyes) に使う anime-face-alignment のイメージ (ビルドはしない)
ANIME_FA_IMAGE=anime-face-alignment:latest

# --- 実行環境 ---
# 使う GPU 番号
GPU_ID=0
# ベースイメージ (ホストのドライバが対応する CUDA 以下を選ぶ) と、CUDA 違いのイメージを区別するタグ
BASE_IMAGE=pytorch/pytorch:2.4.1-cuda12.4-cudnn9-devel
IMAGE_TAG=latest
# コンテナを実行するホストのユーザー (id -u / id -g の値)
HOST_UID=1000
HOST_GID=1000
